{
  "name": "templar-labs",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "scripts": {
    "build": "turbo build",
    "check": "pnpm check:monorepo && pnpm format:check && pnpm lint && turbo check --concurrency=2",
    "check:monorepo": "pnpm --filter @templar/monorepo-check run check:monorepo",
    "db": "node scripts/db.mjs",
    "db:generate": "node scripts/db.mjs generate",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:migrate:ci": "node scripts/db.mjs migrate --prod --all",
    "db:migrate:local": "node scripts/db.mjs migrate --local",
    "db:migrate:prod": "node scripts/db.mjs migrate --prod",
    "deploy": "node scripts/deploy-projects.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:all": "turbo dev",
    "dev-ports": "pnpm --filter @templar/dev-ports dev-ports",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "pnpm lint:biome && pnpm lint:oxlint && turbo lint",
    "lint:biome": "biome lint .",
    "lint:oxlint": "oxlint .",
    "prepare": "lefthook install",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "effect": "^3.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@templar/tsconfig": "workspace:*",
    "@types/node": "^24.12.4",
    "alchemy": "^0.93.7",
    "drizzle-kit": "^0.31.8",
    "lefthook": "^2.1.6",
    "oxlint": "^1.64.0",
    "turbo": "^2.9.12",
    "typescript": "6.0.3",
    "wrangler": "^4.90.1"
  }
}
