# Add this to the monorepo ROOT .env for local Alchemy runs.
# Add the same value as the GitHub Actions repository secret CHINA_CREW_EMAILS.
# Comma-, semicolon-, or whitespace-separated Google account emails. Empty = no guest access.
# Verified central Templar platform admins retain owner access through their signed SSO claim.
CHINA_CREW_EMAILS=
# TEMPLAR_AUTH_SECRET and Cloudflare/Alchemy credentials use the existing shared setup.
