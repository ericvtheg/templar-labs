{
  "name": "china",
  "private": true,
  "type": "module",
  "scripts": {
    "audio:pull": "node --experimental-strip-types scripts/speech-assets.mjs pull",
    "audio:generate": "node --experimental-strip-types scripts/speech-assets.mjs generate",
    "audio:check": "node --experimental-strip-types scripts/speech-assets.mjs check",
    "audio:upload": "node --experimental-strip-types scripts/speech-assets.mjs upload",
    "build": "node ../../scripts/project-build.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm audio:check",
    "deploy": "alchemy deploy alchemy.run.ts --stage prod --profile templar-labs",
    "destroy": "alchemy destroy alchemy.run.ts --stage prod --profile templar-labs",
    "dev": "alchemy dev alchemy.run.ts --stage prod --profile templar-labs",
    "lint": "echo 'Linting is handled by the root lint pipeline.'",
    "test": "echo 'No tests configured yet.'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@templar/deploy": "workspace:*",
    "@templar/dev-ports": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "alchemy": "^0.93.7",
    "drizzle-kit": "^0.31.10",
    "typescript": "6.0.3"
  }
}
