{
  "name": "health-exporter-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build": "pnpm typecheck",
    "check": "pnpm typecheck && pnpm test",
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node --test test/*.test.ts",
    "deploy": "node -e \"console.error('No automatic mobile deploy. Establish identity/signing and explicitly use EAS internal-testflight.'); process.exit(1)\""
  },
  "dependencies": {
    "expo": "~55.0.31",
    "expo-crypto": "~55.0.19",
    "expo-modules-core": "~55.0.26",
    "expo-secure-store": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/react": "~19.2.0",
    "typescript": "6.0.3"
  }
}
