{
  "name": "little-chaos-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "deploy": "pnpm --dir ../.. deploy",
    "dev": "vite --host 0.0.0.0",
    "lint": "echo 'Linting is handled by the root lint pipeline.'",
    "serve": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@templar/dev-ports": "workspace:*",
    "@types/node": "^24.12.4",
    "typescript": "6.0.3",
    "vite": "^7.1.9"
  }
}
