{
  "name": "offscroll-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:local": "wrangler d1 execute offscroll-local --local --file ../../../../packages/users/migrations/-0001_templar_users.sql && wrangler d1 migrations apply offscroll-local --local",
    "deploy": "pnpm --dir ../.. deploy",
    "dev": "pnpm db:local && vite --host 0.0.0.0",
    "lint": "echo 'Linting is handled by the root lint pipeline.'",
    "serve": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@templar/db": "workspace:*",
    "@templar/dev-ports": "workspace:*",
    "@templar/ui": "workspace:*",
    "@templar/users": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.2",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "^4.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.11.6",
    "@cloudflare/workers-types": "4.20260511.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "alchemy": "^0.93.7",
    "typescript": "6.0.3",
    "vite": "^7.1.9",
    "wrangler": "^4.90.1"
  }
}
