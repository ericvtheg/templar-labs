{
  "name": "swedish-fifty-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "deploy": "pnpm --dir ../.. deploy",
    "destroy": "pnpm --dir ../.. destroy",
    "dev": "pnpm --dir ../.. dev",
    "lint": "echo 'Linting is handled by the root lint pipeline.'",
    "serve": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.49.1",
