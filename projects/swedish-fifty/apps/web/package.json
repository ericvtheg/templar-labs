    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "@templar/ai": "workspace:*",
    "@templar/auth": "workspace:*",
    "@templar/db": "workspace:*",
    "@templar/deploy": "workspace:*",
    "@templar/dev-ports": "workspace:*",
    "@templar/payments": "workspace:*",
    "@templar/ui": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.2",
    "lucide-react": "^1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
