    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "alchemy": "0.93.7",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.9",
    "vitest": "^3.0.5",
    "web-vitals": "^4.2.4"
