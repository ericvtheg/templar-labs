{
  "extends": "@templar/tsconfig/tanstack-start-app",
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@templar/ui/components": ["../../../../packages/ui/src/components"],
      "@templar/ui/components/*": ["../../../../packages/ui/src/components/*"]
    },
    "types": ["vite/client", "@cloudflare/workers-types"]
  }
}
