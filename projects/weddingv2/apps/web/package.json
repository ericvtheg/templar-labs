{
  "name": "weddingv2-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "deploy": "echo 'weddingv2 is a design exploration and is not deployed.'",
    "dev": "vite --host 127.0.0.1",
    "lint": "echo 'Linting is handled by the root lint pipeline.'",
    "serve": "vite preview --host 127.0.0.1",
    "shots": "node tools/shots.mjs",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@fontsource/lustria": "^5.2.0",
    "@fontsource/nothing-you-could-do": "^5.2.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@templar/dev-ports": "workspace:*",
    "@templar/tsconfig": "workspace:*",
    "@types/node": "^24.12.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "6.0.3",
    "vite": "^7.1.9"
  }
}
