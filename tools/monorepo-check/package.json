{
  "name": "@templar/monorepo-check",
  "version": "0.0.1",
  "private": true,
  "description": "Validate Templar Labs monorepo package conventions.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:monorepo": "node src/index.ts",
    "lint": "echo 'Linting is handled by the root lint pipeline.'",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@templar/tsconfig": "workspace:*",
    "@types/node": "^24.12.4",
    "typescript": "6.0.3"
  }
}
